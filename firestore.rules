rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Админ = анонимный Firebase uid, зарегистрированный в config/admins/adminsLive/{uid}.
    // Регистрация разрешена только если vkId входит в список config/admins (VK ID организаторов).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/config/admins/adminsLive/$(request.auth.uid));
    }

    // ---------- Пользователи ----------
    // Документ участника: id = "vk_<VK ID>" — общий для всех устройств одного аккаунта ВК.
    // Чтение: любой авторизованный (нужно для рейтинга топ-10).
    // Запись: участник — только в свой документ (id совпадает с vkId в документе),
    // причём баллы нельзя уменьшать самому (уменьшает только админ).
    // Чужие документы, удаление, корректировка баллов — только админ.
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      allow create: if request.auth != null && userId == 'vk_' + request.resource.data.vkId;
      allow update: if request.auth != null &&
        userId == 'vk_' + request.resource.data.vkId &&
        request.resource.data.score >= resource.data.score;
    }

    // ---------- Расписание ----------
    match /schedule/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Задания ----------
    match /tasks/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Фото/видео-заявки ----------
    // Создаёт участник (uid = "vk_<vkId>", как в users/). Читает/правит бот
    // (сервисный аккаунт — правила не применяются) и админ.
    // Чанки видео лежат в подколлекции submissions/{doc}/chunks: пишет их тот же
    // участник и только к СВОЕЙ заявке (родитель уже создан и uid совпадает).
    match /submissions/{doc} {
      allow create: if request.auth != null &&
        request.resource.data.uid == 'vk_' + request.resource.data.vkId;
      allow read, update, delete: if isAdmin();

      match /chunks/{chunk} {
        allow read: if isAdmin();
        allow delete: if isAdmin();
        allow create, update: if request.auth != null &&
          request.resource.data.uid == 'vk_' + request.resource.data.vkId &&
          exists(/databases/$(database)/documents/submissions/$(doc)) &&
          get(/databases/$(database)/documents/submissions/$(doc)).data.uid ==
            'vk_' + request.resource.data.vkId;
      }
    }

    // ---------- Рейтинг округов (агрегат) ----------
    // Читают все участники (1 документ), пишет только админ-панель
    // после начислений — чтобы не читать ~150 документов каждому.
    match /rating/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Бейджи ----------
    // Картинка хранится сжатым dataURL внутри документа (лимит 1 МБ).
    // Выдача участнику — массив id в users/{userId}.badges.
    match /badges/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- Конфиг ----------
    // Технический перерыв: читают все участники (живая подписка), включает админ.
    match /config/maintenance {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Список админов (VK ID) — только чтение, изменение только из консоли Firebase.
    match /config/admins {
      allow read: if true;
      allow write: if false;

      // Регистрация админа: собственный uid + vkId обязан быть в списке админов.
      match /adminsLive/{uid} {
        allow read: if isAdmin();
        allow write: if request.auth != null && request.auth.uid == uid &&
          request.resource.data.vkId in
            get(/databases/$(database)/documents/config/admins).data.ids;
      }
    }
  }
}
